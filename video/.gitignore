# Raw footage and everything derived from it. Video does not belong in git.
footage/*
!footage/.gitkeep

# video-use writes all session output into <videos_dir>/edit/
edit/
**/edit/

# Hyperframes render scratch
**/renders/
*.mp4
*.mov
*.webm
*.wav
*.mp3

# Secrets
.env

# Finished episodes are the exception to the no-video rule: they are the
# deliverable, and a link that 404s is worse than a large blob. Keep them
# under GitHub's 100MB limit (CRF 23 does that for screen-recorded content
# without visible loss) and only commit a final cut, never working renders.
!deliverables/
!deliverables/*.mp4

# Tooling
node_modules/
.warmup/

# WLAM clip cutter: code and reasoning only.
# The b-roll library is 53.66GB full / 7.12GB as a distribution copy (broll.py
# prune-src drops the re-bake cache). It travels out of band, never through git.
skills/WLAM-clip-cutter/broll-library/
skills/WLAM-clip-cutter/work/
skills/WLAM-clip-cutter/**/__pycache__/
skills/WLAM-clip-cutter/**/.vocabcheck/
skills/WLAM-clip-cutter/**/.search-cache.json
# Per-show state written into the CODE directory - the bug, not an artifact to keep.
skills/WLAM-clip-cutter/scripts/posters.json
skills/WLAM-clip-cutter/scripts/slate.json
skills/WLAM-clip-cutter/scripts/cues.json
skills/WLAM-clip-cutter/scripts/project.json
