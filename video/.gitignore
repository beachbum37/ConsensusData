# Raw footage and everything derived from it. Video does not belong in git.
footage/*
!footage/.gitkeep

# video-use writes all session output into <videos_dir>/edit/
edit/
**/edit/

# Hyperframes render scratch
**/renders/
*.mp4
*.mov
*.webm
*.wav
*.mp3

# Secrets
.env

# Source audio for a slide-driven episode is small enough to carry in git,
# and it is the only way footage on a contributor's machine reaches a cloud
# session. Video stays ignored; this exception is audio + the deck only.
!footage/scifi/
!footage/scifi/*.mp3
!footage/scifi/*.pptx

# Finished episodes are the exception to the no-video rule: they are the
# deliverable, and a link that 404s is worse than a large blob. Keep them
# under GitHub's 100MB limit (CRF 23 does that for screen-recorded content
# without visible loss) and only commit a final cut, never working renders.
!deliverables/
!deliverables/*.mp4

# Tooling
node_modules/
.warmup/
